# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-public
SUPABASE_SERVICE_ROLE_KEY=cole-a-chave-service_role

# E-mail da conta Google que pode entrar no painel /admin
ADMIN_EMAIL=seu-email@gmail.com

# Texto aleatório longo (assina o cookie da senha do site)
SESSION_SECRET=troque-por-um-texto-aleatorio-com-uns-40-caracteres

# Texto aleatório (a Vercel usa para chamar a tarefa diária)
CRON_SECRET=troque-por-outro-texto-aleatorio
